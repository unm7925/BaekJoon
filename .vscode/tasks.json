{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "MSVC: build active file",
            "command": "call \"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul && (if not exist \"${workspaceFolder}\\build\" mkdir \"${workspaceFolder}\\build\") && cl /nologo /std:c++17 /EHsc /Zi /Od /utf-8 /I\"${workspaceFolder}\\.vscode\\include\" /Fo${workspaceFolder}\\build\\ /Fd${workspaceFolder}\\build\\ /Fe${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe \"${file}\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Windows: MSVC로 빌드, 결과물은 build 폴더"
        }
    ],
    "version": "2.0.0"
}